{
  "name": "scheherazade",
  "version": "0.5.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Mac-native local AI agent. Forked from agent-portable (Claude Code single-agent harness); P0 spike layers an Electron packaging shell on top.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "main": "main.cjs",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "start": "node channel.mjs",
    "electron:dev": "electron .",
    "dist": "node tools/assert-platform.mjs mac && electron-builder --mac dmg --publish never",
    "dist:mac": "node tools/assert-platform.mjs mac && electron-builder --mac dmg --publish never",
    "dist:win": "node tools/assert-platform.mjs win && electron-builder --win nsis --publish never",
    "dist:linux": "node tools/assert-platform.mjs linux && electron-builder --linux AppImage --x64 --publish never",
    "predist": "node tools/assert-platform.mjs mac && node tools/test-packaging.mjs",
    "postdist": "node tools/test-packaging.mjs",
    "predist:mac": "node tools/assert-platform.mjs mac && node tools/test-packaging.mjs",
    "postdist:mac": "node tools/test-packaging.mjs",
    "predist:win": "node tools/assert-platform.mjs win && node tools/test-packaging.mjs",
    "postdist:win": "node tools/test-packaging.mjs",
    "predist:linux": "node tools/assert-platform.mjs linux && node tools/test-packaging.mjs",
    "postdist:linux": "node tools/test-packaging.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "codex-as-api": "0.6.5",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "undici": "^7.28.0",
    "zod": "^4.4.3",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7",
    "koffi": "3.1.5"
  },
  "build": {
    "appId": "com.choam.scheherazade",
    "productName": "Scheherazade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "updater.cjs",
      "notify-agent-reply.cjs",
      "window-glass.cjs",
      "companion/**/*",
      "attach-topology.cjs",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "channel-backends.cjs",
      "channel-companions.mjs",
      "turn-gate.mjs",
      "provider-env.cjs",
      "model-discovery.cjs",
      "codex-proxy-shim.cjs",
      "route-proxy.cjs",
      "setup-token.cjs",
      "setup-token-session.cjs",
      "oauth-usage-session.cjs",
      "tcc-probe.cjs",
      "data-home.cjs",
      "local-date.cjs",
      "proc.cjs",
      "quit-sequencer.cjs",
      "supervisor.mjs",
      "headless-lane.mjs",
      "dsh-client.cjs",
      "dsh-lane.mjs",
      "turn-error-marker.mjs",
      ".mcp.json",
      "onboarding/**/*",
      "hooks/**/*",
      "scripts/journal-compress.mjs",
      "scripts/madoromi-solo.mjs",
      "scripts/persona-reflux.mjs",
      "scripts/persona-apply.mjs",
      "autonomy/**/*",
      "cadence/**/*",
      "calendar/**/*",
      "memory/**/*",
      "procedures/**/*",
      "docs/release-notes-v*.md",
      "!docs/release-notes-v*.ko.md",
      "CLAUDE.md",
      "ONTOLOGY_GUIDE.md",
      "BUILD_INFO.json",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/chromux",
        "to": "chromux"
      },
      {
        "from": "onboarding/agent-tools",
        "to": "agent-tools"
      }
    ],
    "asarUnpack": [
      "memory/import-candidates.cjs",
      "memory/migrate-import.cjs",
      "node_modules/**",
      "memory/**",
      "memory/entity-index.mjs",
      "memory/service.mjs",
      "memory/turn-context.mjs",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "channel-backends.cjs",
      "channel-companions.mjs",
      "turn-gate.mjs",
      "data-home.cjs",
      "model-discovery.cjs",
      "local-date.cjs",
      "proc.cjs",
      "supervisor.mjs",
      "headless-lane.mjs",
      "dsh-client.cjs",
      "dsh-lane.mjs",
      "turn-error-marker.mjs",
      "onboarding/public/js/model-catalog.cjs",
      "onboarding/chromux-live-consent.cjs",
      "onboarding/chromux-live-gate.cjs",
      "hooks/**",
      "scripts/**",
      "autonomy/**",
      "cadence/**",
      "calendar/**"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "vendor/tmux-portable",
          "to": "tmux-portable"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 companion\uc758 \uc9c0\uc18d \uae30\uc5b5\uc744 Documents/Scheherazade \ud3f4\ub354\uc5d0 \uc800\uc7a5\ud569\ub2c8\ub2e4.",
        "NSDownloadsFolderUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 companion \uc5d0\uc774\uc804\ud2b8\ub97c \uc704\ud574 Downloads \ud3f4\ub354\uc758 \ud30c\uc77c\uc744 \uc77d\uace0 \uc501\ub2c8\ub2e4.",
        "NSDesktopFolderUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 companion \uc5d0\uc774\uc804\ud2b8\ub97c \uc704\ud574 Desktop \ud3f4\ub354\uc758 \ud30c\uc77c\uc744 \uc77d\uace0 \uc501\ub2c8\ub2e4.",
        "NSCalendarsFullAccessUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 \uc624\ub298 \ubb34\uc2a8 \uc77c\uc815\uc774 \uc788\ub294\uc9c0 \uc54c\uace0 \ub300\ud654\ud558\uae30 \uc704\ud574 \uce98\ub9b0\ub354\ub97c \uc77d\uc2b5\ub2c8\ub2e4. \uc77c\uc815\uc744 \ucd94\uac00\ud558\uac70\ub098 \uc218\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
        "NSCalendarsUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 \uc624\ub298 \ubb34\uc2a8 \uc77c\uc815\uc774 \uc788\ub294\uc9c0 \uc54c\uace0 \ub300\ud654\ud558\uae30 \uc704\ud574 \uce98\ub9b0\ub354\ub97c \uc77d\uc2b5\ub2c8\ub2e4. \uc77c\uc815\uc744 \ucd94\uac00\ud558\uac70\ub098 \uc218\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
      }
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scheherazade-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scheherazade-${version}-x86_64.AppImage",
      "category": "Utility",
      "icon": "build/icon_1024.png"
    },
    "asar": true,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Mino-is-me",
        "repo": "scheherazade-releases"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
