{
  "name": "scheherazade",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Mac-native local AI agent. Forked from agent-portable (Claude Code single-agent harness); P0 spike layers an Electron packaging shell on top.",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "node channel.mjs",
    "electron:dev": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:mac": "npm run dist",
    "dist:win": "node scripts/assert-win32.mjs && electron-builder --win nsis",
    "postinstall": "node scripts/fix-pty-helper.mjs",
    "predist": "node scripts/test-packaging.mjs",
    "postdist": "node scripts/test-packaging.mjs",
    "predist:win": "node scripts/test-packaging.mjs",
    "postdist:win": "node scripts/test-packaging.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.199",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "codex-as-api": "0.5.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.choam.scheherazade",
    "productName": "Scheherazade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "window-glass.cjs",
      "attach-topology.cjs",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "provider-env.cjs",
      "setup-token.cjs",
      "setup-token-session.cjs",
      "tcc-probe.cjs",
      "run.sh",
      "supervisor.mjs",
      "headless-lane.mjs",
      ".mcp.json",
      "onboarding/**/*",
      "hooks/**/*",
      "scripts/**/*",
      "autonomy/**/*",
      "cadence/**/*",
      "calendar/**/*",
      "docs/**/*",
      "memory/**/*",
      "procedures/**/*",
      "CLAUDE.md",
      "ONTOLOGY_GUIDE.md",
      "README.md",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@anthropic-ai/claude-code/**/*",
      "!node_modules/@anthropic-ai/claude-code-*/**/*"
    ],
    "asarUnpack": [
      "node_modules/**",
      "memory/**",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "run.sh",
      "supervisor.mjs",
      "headless-lane.mjs",
      "hooks/**",
      "scripts/**",
      "autonomy/**",
      "cadence/**",
      "calendar/**"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "vendor/tmux-portable",
          "to": "tmux-portable"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "세헤라자드가 companion의 지속 기억을 Documents/Scheherazade 폴더에 저장합니다.",
        "NSDownloadsFolderUsageDescription": "세헤라자드가 companion 에이전트를 위해 Downloads 폴더의 파일을 읽고 씁니다.",
        "NSDesktopFolderUsageDescription": "세헤라자드가 companion 에이전트를 위해 Desktop 폴더의 파일을 읽고 씁니다.",
        "NSCalendarsFullAccessUsageDescription": "세헤라자드가 오늘 무슨 일정이 있는지 알고 대화하기 위해 캘린더를 읽습니다. 일정을 추가하거나 수정하지 않습니다.",
        "NSCalendarsUsageDescription": "세헤라자드가 오늘 무슨 일정이 있는지 알고 대화하기 위해 캘린더를 읽습니다. 일정을 추가하거나 수정하지 않습니다."
      }
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scheherazade-Setup-${version}.exe"
    },
    "asar": true,
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "@anthropic-ai/claude-code": true,
    "electron": true,
    "electron-winstaller": true,
    "node-pty": true
  }
}
