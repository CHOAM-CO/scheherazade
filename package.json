{
  "name": "scheherazade",
  "version": "0.0.66",
  "private": true,
  "type": "module",
  "description": "Mac-native local AI agent. Forked from agent-portable (Claude Code single-agent harness); P0 spike layers an Electron packaging shell on top.",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "node channel.mjs",
    "electron:dev": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:mac": "npm run dist",
    "dist:win": "node scripts/assert-win32.mjs && electron-builder --win nsis",
    "postinstall": "node scripts/fix-pty-helper.mjs",
    "predist": "node scripts/test-packaging.mjs",
    "postdist": "node scripts/test-packaging.mjs",
    "predist:win": "node scripts/test-packaging.mjs",
    "postdist:win": "node scripts/test-packaging.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.199",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "codex-as-api": "0.5.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.choam.scheherazade",
    "productName": "Scheherazade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "window-glass.cjs",
      "attach-topology.cjs",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "provider-env.cjs",
      "setup-token.cjs",
      "setup-token-session.cjs",
      "tcc-probe.cjs",
      "run.sh",
      "supervisor.mjs",
      "headless-lane.mjs",
      ".mcp.json",
      "onboarding/**/*",
      "hooks/**/*",
      "scripts/**/*",
      "autonomy/**/*",
      "cadence/**/*",
      "calendar/**/*",
      "docs/**/*",
      "memory/**/*",
      "procedures/**/*",
      "CLAUDE.md",
      "ONTOLOGY_GUIDE.md",
      "README.md",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@anthropic-ai/claude-code/**/*",
      "!node_modules/@anthropic-ai/claude-code-*/**/*"
    ],
    "asarUnpack": [
      "node_modules/**",
      "memory/**",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "run.sh",
      "supervisor.mjs",
      "headless-lane.mjs",
      "hooks/**",
      "scripts/**",
      "autonomy/**",
      "cadence/**",
      "calendar/**"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "vendor/tmux-portable",
          "to": "tmux-portable"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 companion\uc758 \uc9c0\uc18d \uae30\uc5b5\uc744 Documents/Scheherazade \ud3f4\ub354\uc5d0 \uc800\uc7a5\ud569\ub2c8\ub2e4.",
        "NSDownloadsFolderUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 companion \uc5d0\uc774\uc804\ud2b8\ub97c \uc704\ud574 Downloads \ud3f4\ub354\uc758 \ud30c\uc77c\uc744 \uc77d\uace0 \uc501\ub2c8\ub2e4.",
        "NSDesktopFolderUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 companion \uc5d0\uc774\uc804\ud2b8\ub97c \uc704\ud574 Desktop \ud3f4\ub354\uc758 \ud30c\uc77c\uc744 \uc77d\uace0 \uc501\ub2c8\ub2e4.",
        "NSCalendarsFullAccessUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 \uc624\ub298 \ubb34\uc2a8 \uc77c\uc815\uc774 \uc788\ub294\uc9c0 \uc54c\uace0 \ub300\ud654\ud558\uae30 \uc704\ud574 \uce98\ub9b0\ub354\ub97c \uc77d\uc2b5\ub2c8\ub2e4. \uc77c\uc815\uc744 \ucd94\uac00\ud558\uac70\ub098 \uc218\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
        "NSCalendarsUsageDescription": "\uc138\ud5e4\ub77c\uc790\ub4dc\uac00 \uc624\ub298 \ubb34\uc2a8 \uc77c\uc815\uc774 \uc788\ub294\uc9c0 \uc54c\uace0 \ub300\ud654\ud558\uae30 \uc704\ud574 \uce98\ub9b0\ub354\ub97c \uc77d\uc2b5\ub2c8\ub2e4. \uc77c\uc815\uc744 \ucd94\uac00\ud558\uac70\ub098 \uc218\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
      }
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scheherazade-Setup-${version}.exe"
    },
    "asar": true,
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "@anthropic-ai/claude-code": true,
    "electron": true,
    "electron-winstaller": true,
    "node-pty": true
  }
}
