{
  "name": "scheherazade",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mac-native local AI agent. Forked from agent-portable (Claude Code single-agent harness); P0 spike layers an Electron packaging shell on top.",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "node channel.mjs",
    "electron:dev": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.199",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.choam.scheherazade",
    "productName": "Scheherazade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "channel.mjs",
      "run.sh",
      ".mcp.json",
      "onboarding/**/*",
      "hooks/**/*",
      "scripts/**/*",
      "docs/**/*",
      "memory/**/*",
      "CLAUDE.md",
      "README.md",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@anthropic-ai/claude-code/**/*",
      "!node_modules/@anthropic-ai/claude-code-*/**/*"
    ],
    "asarUnpack": [
      "node_modules/**",
      "memory/**",
      "channel.mjs",
      "run.sh"
    ],
    "extraResources": [
      {
        "from": "node_modules/@anthropic-ai/claude-code/bin/claude.exe",
        "to": "claude-cli/claude"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    },
    "asar": true
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
