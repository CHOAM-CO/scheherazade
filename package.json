{
  "name": "scheherazade",
  "version": "0.3.14",
  "private": true,
  "type": "module",
  "description": "Mac-native local AI agent. Forked from agent-portable (Claude Code single-agent harness); P0 spike layers an Electron packaging shell on top.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "main": "main.cjs",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "start": "node channel.mjs",
    "electron:dev": "electron .",
    "dist": "node tools/assert-platform.mjs mac && electron-builder --mac dmg --publish never",
    "dist:mac": "node tools/assert-platform.mjs mac && electron-builder --mac dmg --publish never",
    "dist:win": "node tools/assert-platform.mjs win && electron-builder --win nsis --publish never",
    "dist:linux": "node tools/assert-platform.mjs linux && electron-builder --linux AppImage --x64 --publish never",
    "predist": "node tools/assert-platform.mjs mac && node tools/test-packaging.mjs",
    "postdist": "node tools/test-packaging.mjs",
    "predist:mac": "node tools/assert-platform.mjs mac && node tools/test-packaging.mjs",
    "postdist:mac": "node tools/test-packaging.mjs",
    "predist:win": "node tools/assert-platform.mjs win && node tools/test-packaging.mjs",
    "postdist:win": "node tools/test-packaging.mjs",
    "predist:linux": "node tools/assert-platform.mjs linux && node tools/test-packaging.mjs",
    "postdist:linux": "node tools/test-packaging.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "codex-as-api": "0.6.5",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "undici": "^7.28.0",
    "zod": "^4.4.3",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7"
  },
  "build": {
    "appId": "com.choam.scheherazade",
    "productName": "Scheherazade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "updater.cjs",
      "notify-agent-reply.cjs",
      "window-glass.cjs",
      "attach-topology.cjs",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "channel-backends.cjs",
      "channel-companions.mjs",
      "turn-gate.mjs",
      "provider-env.cjs",
      "model-discovery.cjs",
      "codex-proxy-shim.cjs",
      "route-proxy.cjs",
      "setup-token.cjs",
      "setup-token-session.cjs",
      "oauth-usage-session.cjs",
      "tcc-probe.cjs",
      "data-home.cjs",
      "local-date.cjs",
      "proc.cjs",
      "quit-sequencer.cjs",
      "supervisor.mjs",
      "headless-lane.mjs",
      "dsh-client.cjs",
      "dsh-lane.mjs",
      "turn-error-marker.mjs",
      ".mcp.json",
      "onboarding/**/*",
      "hooks/**/*",
      "scripts/journal-compress.mjs",
      "scripts/madoromi-solo.mjs",
      "scripts/persona-reflux.mjs",
      "scripts/persona-apply.mjs",
      "autonomy/**/*",
      "cadence/**/*",
      "calendar/**/*",
      "memory/**/*",
      "procedures/**/*",
      "docs/release-notes-v*.md",
      "!docs/release-notes-v*.ko.md",
      "CLAUDE.md",
      "ONTOLOGY_GUIDE.md",
      "BUILD_INFO.json",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/chromux",
        "to": "chromux"
      },
      {
        "from": "onboarding/agent-tools",
        "to": "agent-tools"
      }
    ],
    "asarUnpack": [
      "memory/import-candidates.cjs",
      "memory/migrate-import.cjs",
      "node_modules/**",
      "memory/**",
      "memory/entity-index.mjs",
      "memory/service.mjs",
      "memory/turn-context.mjs",
      "channel.mjs",
      "channel-slack.mjs",
      "channel-telegram.mjs",
      "channel-local.mjs",
      "channel-runtime.mjs",
      "channel-backends.cjs",
      "channel-companions.mjs",
      "turn-gate.mjs",
      "data-home.cjs",
      "model-discovery.cjs",
      "local-date.cjs",
      "proc.cjs",
      "supervisor.mjs",
      "headless-lane.mjs",
      "dsh-client.cjs",
      "dsh-lane.mjs",
      "turn-error-marker.mjs",
      "onboarding/public/js/model-catalog.cjs",
      "onboarding/chromux-live-consent.cjs",
      "onboarding/chromux-live-gate.cjs",
      "hooks/**",
      "scripts/**",
      "autonomy/**",
      "cadence/**",
      "calendar/**"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "vendor/tmux-portable",
          "to": "tmux-portable"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "세헤라자드가 companion의 지속 기억을 Documents/Scheherazade 폴더에 저장합니다.",
        "NSDownloadsFolderUsageDescription": "세헤라자드가 companion 에이전트를 위해 Downloads 폴더의 파일을 읽고 씁니다.",
        "NSDesktopFolderUsageDescription": "세헤라자드가 companion 에이전트를 위해 Desktop 폴더의 파일을 읽고 씁니다.",
        "NSCalendarsFullAccessUsageDescription": "세헤라자드가 오늘 무슨 일정이 있는지 알고 대화하기 위해 캘린더를 읽습니다. 일정을 추가하거나 수정하지 않습니다.",
        "NSCalendarsUsageDescription": "세헤라자드가 오늘 무슨 일정이 있는지 알고 대화하기 위해 캘린더를 읽습니다. 일정을 추가하거나 수정하지 않습니다."
      }
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scheherazade-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scheherazade-${version}-x86_64.AppImage",
      "category": "Utility",
      "icon": "build/icon_1024.png"
    },
    "asar": true,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Mino-is-me",
        "repo": "scheherazade-releases"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
