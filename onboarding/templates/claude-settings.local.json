{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "mcp__agent-channel__reply",
      "mcp__agent-channel__send_file_to_discord",
      "mcp__agent-channel__read_channel_history",
      "mcp__agent-channel__react",
      "mcp__agent-channel__routine",
      "mcp__memory__memory_write",
      "mcp__memory__memory_query",
      "mcp__memory__memory_confirm",
      "mcp__memory__memory_delete",
      "mcp__memory__memory_recall_material"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/session-start.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/session-start-reflux-card.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/context-gauge.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/post-bash-permission-translator.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/post-bash-receipt-ledger.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-ask-user-question-redirect.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|WebSearch|WebFetch|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-tool-activity.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-tool-credential-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-tool-credential-guard.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__agent-channel__reply",
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-reply-rumination-gate.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-reply-corrections-context.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-reply-time-adverb-guard.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/pre-reply-negation-check.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/checkpoint-nudge.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/stop-reply-guard.mjs"
          },
          {
            "type": "command",
            "command": "node {AGENT_DIR}/hooks/context-gauge.mjs"
          }
        ]
      }
    ]
  }
}
